# Copie para o painel do Netlify: Site configuration → Environment variables
# (ou para um arquivo .env local, que nunca deve ir para o Git)

# A base de festivais fica em site/dados/festivais.csv (não precisa de variável).

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # pública (vai para o navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SECRETA (só funções do servidor)

# Resend — e-mails de lembrete
RESEND_API_KEY=re_...
RESEND_FROM="Radar de Curtas <onboarding@resend.dev>"

# Texto longo e aleatório para assinar links de descadastro (ex.: openssl rand -hex 32)
UNSUBSCRIBE_SECRET=

# Opcional: endereço público do site (o Netlify já define URL automaticamente).
# Depois do domínio próprio: SITE_URL=https://www.radardefestivais.com.br
# SITE_URL=https://radar-de-curtas.netlify.app
